# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/jhumroo
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/jhumroo?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production
JWT_EXPIRE=7d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMS Configuration for OTP (Indian Providers)
# Choose one provider and configure its credentials

# Option 1: MSG91 (Recommended for India)
# Sign up at: https://msg91.com/
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_TEMPLATE_ID=your_template_id
# MSG91_SENDER_ID=JHUMRO

# Option 2: Fast2SMS (Indian SMS Service)
# Sign up at: https://www.fast2sms.com/
# FAST2SMS_API_KEY=your_fast2sms_api_key

# Option 3: TextLocal (India + International)
# Sign up at: https://www.textlocal.in/
# TEXTLOCAL_API_KEY=your_textlocal_api_key
# TEXTLOCAL_SENDER=JHUMRO

# App Configuration
OTP_EXPIRY_MINUTES=10
MAX_VIDEO_SIZE_MB=100
